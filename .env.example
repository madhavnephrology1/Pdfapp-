# =============================================================================
# PDF Human Reader — example configuration
#
# Copy to .env and edit. The API reads this file; the web app reads only the
# NEXT_PUBLIC_* values, which are compiled into the browser bundle.
#
# NEVER put a provider API key in a NEXT_PUBLIC_* variable: those are visible
# to anyone who loads the page. Provider credentials belong to the API only.
# =============================================================================

APP_ENV=development

# Origins allowed to call the API. Comma-separated. Both loopback spellings are
# listed because a browser treats them as different origins.
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

API_HOST=0.0.0.0
API_PORT=8000


# -----------------------------------------------------------------------------
# Text to speech
# -----------------------------------------------------------------------------
# Leave TTS_PROVIDER empty to run with no server provider at all. The app then
# uses the browser's own speech engine and says so in the interface — a fully
# supported mode, not a degraded one.
#
# Supported values: openai | elevenlabs | azure | mock
#   openai      — neural voices, no word timings (word position is estimated)
#   elevenlabs  — neural voices WITH real word timings (exact highlighting)
#   azure       — neural voices, native speed via SSML, no word timings
#   mock        — offline, deterministic, silent audio; for tests and demos
TTS_PROVIDER=
TTS_API_KEY=
# Required by the azure adapter only, e.g. eastus
TTS_REGION=
# Optional. Falls back to the provider's first listed voice.
TTS_DEFAULT_VOICE=
TTS_REQUEST_TIMEOUT_SECONDS=30
# Upper bound on characters per synthesis request. The effective limit is the
# lower of this and the provider's own maximum.
TTS_MAX_CHARS_PER_CHUNK=2500


# -----------------------------------------------------------------------------
# Optical character recognition (for scanned pages)
# -----------------------------------------------------------------------------
# Leave empty to disable. When disabled, scanned pages are reported as having no
# readable text; nothing is ever guessed.
# Supported values: mock
OCR_PROVIDER=
OCR_API_KEY=
OCR_REGION=


# -----------------------------------------------------------------------------
# Temporary files
# -----------------------------------------------------------------------------
# Where server-side temporary files go. Defaults to ./tmp/pdf-human-reader.
# Files are created owner-only, deleted as soon as the request finishes, and
# swept every 5 minutes in case a crash left one behind.
TEMP_FILE_DIRECTORY=
TEMP_FILE_RETENTION_MINUTES=60


# -----------------------------------------------------------------------------
# Limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=100
RATE_LIMIT_TTS_PER_MINUTE=20
RATE_LIMIT_OCR_PER_MINUTE=10

# Server-side audio cache. In memory only; never written to disk.
AUDIO_CACHE_MAX_ENTRIES=512
AUDIO_CACHE_TTL_MINUTES=60


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Development aid only. Document text is NEVER logged when APP_ENV is
# production, whatever this is set to.
LOG_DOCUMENT_CONTENT=false


# -----------------------------------------------------------------------------
# Web app (compiled into the browser bundle — no secrets here)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAX_UPLOAD_MB=100
